c("ROC" = "AUC-ROC",
"PRC" = "AUC-PRC")
)) +
annotate("rect", xmin = 3.5, xmax = 3.5, ymin = -Inf, ymax = Inf,
linetype = "dashed", color = "red", size = 1)+theme_bw() +
theme(text = element_text(size = 20), legend.position = 'none') +
